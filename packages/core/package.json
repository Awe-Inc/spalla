{
  "name": "@fretless/core",
  "version": "0.2.0",
  "private": true,
  "description": "Núcleo do Fretless em WebAssembly: partitura, currículo, julgamento e detector de altura.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:debug": "node scripts/build.mjs --debug",
    "test": "node dist/fretless_core_tests.cjs && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
