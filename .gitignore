# ── Build output ──────────────────────────────────────────────────────────
# build/ holds the in-tree clones of SDL, PortAudio, FreeType and friends
# fetched by CMake: ~240 MB that any checkout regenerates.
build/
out/
*.obj
*.lib
*.exe
*.pdb
*.ilk

# CMake / tooling
compile_commands.json
.cache/
CMakeUserPresets.json

# ── Python ────────────────────────────────────────────────────────────────
# tools/ still ships a couple of generator scripts.
__pycache__/
*.py[cod]
.venv/
venv/

# ── Logs ──────────────────────────────────────────────────────────────────
*.log

# ── Proprietary, not redistributable ──────────────────────────────────────
# The Steamworks SDK is under Valve's license: developers download their own.
lib/steamworks/
steam_appid.txt

# ── Editors and OS ────────────────────────────────────────────────────────
.vs/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── Web (pnpm monorepo) ───────────────────────────────────────────────────
node_modules/
dist/
packages/core/build/
packages/core/dist/
apps/web/dev-dist/
*.tsbuildinfo
.claude/settings.local.json

# Playwright
apps/web/test-results/
apps/web/e2e-relatorio/
apps/web/playwright-report/
apps/api/.data/

.env
.env.local
apps/*/.env
apps/*/.env.local
