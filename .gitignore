out/
*.obj
*.lib
*.exe
*.pdb
*.ilk

# CMake / tooling
compile_commands.json
.cache/
CMakeUserPresets.json

# ── Python prototype ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── Logs ──────────────────────────────────────────────────────────────────
install_log.txt
*.log

